# --- Go Binaries & Build Outputs ---
# Compiled templates
*.html
*.pdf
# Executables
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binaries
*.test
*.out
c.out
coverage.out
# Common build output directories
bin/
dist/
build/
out/
# Project binary (assumes it might be named after the directory)
teknik
teknik.exe

# --- Dependency Directories ---
# Go workspace files
go.work
go.work.sum
# Dependency directory (only if using go mod vendor)
vendor/

# --- Environment & Secrets ---
# Block all .env files (very critical)
.env
.env.*
*.env
# Except .env.example which should be committed as a template
!.env.example

# --- IDEs & Editors ---
# JetBrains (GoLand, IntelliJ, WebStorm, etc.)
.idea/
*.iws
*.iml
# VS Code
.vscode/
# Sublime Text
*.sublime-project
*.sublime-workspace
# Vim
*~
*.swp
*.swo
.netrwhist
# Local history / backups
.history/

# --- Operating System Files ---
# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~

# --- Logs & Temporaries ---
*.log
*.tmp
*.pid
.temp/
.cache/

# --- Application Specific ---
# Ignore user-uploaded assets
uploads/*
!uploads/.gitkeep

docker-compose.yml
summary_perubahan.html

# Ignore Excel report files
reports/*.xlsx

randomize_dates.py
frontend